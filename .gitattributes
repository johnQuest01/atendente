# ==========================================================
# Normalizacao de fim de linha (resolve o "ruido" CRLF/LF no Windows)
# ----------------------------------------------------------
# O repositorio guarda SEMPRE em LF (padrao Linux do Render/Vercel).
# Isto sobrepoe o core.autocrlf de forma deterministica, entao
# "arquivo modificado" sem mudanca real para de aparecer.
# ==========================================================
* text=auto eol=lf

# Scripts do Windows precisam de CRLF para rodar de forma confiavel.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Arquivos binarios: nunca normalizar (evita corrupcao).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.m4a   binary
*.mp4   binary
*.webm  binary
*.zip   binary
*.gz    binary
