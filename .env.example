# ==========================================================
# Mayra AI Sales — Variáveis de ambiente (copie para .env)
# ==========================================================

# ---------- Banco de dados Neon (PostgreSQL) ----------
DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/neondb?sslmode=require

# ---------- Autenticação ----------
JWT_SECRET=troque_por_uma_chave_secreta_bem_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# Chave para cifrar as credenciais de WhatsApp de cada empresa (AES-256-GCM).
# Aceita base64/hex de 32 bytes OU qualquer texto (derivamos 32 bytes via SHA-256).
# Gere uma forte, ex.: openssl rand -base64 32
ENCRYPTION_KEY=

# ---------- Super-admin (dono da plataforma) ----------
# E-mail do dono da plataforma: no seed, é promovido a 'superadmin' e pode
# criar/gerenciar empresas. Se a conta ainda não existir, defina a senha abaixo
# para o seed criá-la. Deixe vazio se não usar multi-empresa.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---------- Anthropic Claude API ----------
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-6
# Nome da loja usado pela IA nas conversas (substitui [NOME DA LOJA] no prompt)
STORE_NAME=

# ---------- WhatsApp ----------
# Provedor ativo: "zapi" (SaaS) ou "evolution" (self-hosted)
WHATSAPP_PROVIDER=zapi

# Z-API (quando WHATSAPP_PROVIDER=zapi)
ZAPI_INSTANCE_ID=seu_instance_id
ZAPI_TOKEN=seu_token
ZAPI_BASE_URL=https://api.z-api.io/instances
# Client-Token de segurança da Z-API (opcional, recomendado nas rotas da instância)
ZAPI_CLIENT_TOKEN=
# Partner-Token do programa de integradores (Bearer) — onboarding embutido:
# cria/assina instâncias sem o cliente ver o painel Z-API. Nunca commitar.
# Liberado pela Z-API após ~10 instâncias ativas no programa de parceiro.
# Enquanto vazio: app usa o POOL (Admin → Instâncias prontas).
# Quando preencher: contas active criam instância on-demand; no pagamento
# chame POST /api/tenants/:id/whatsapp/activate-paid para assinar na Z-API.
ZAPI_PARTNER_TOKEN=
# auto = trial usa pool; conta paga usa on-demand (se houver Partner Token).
# Ou force: on-demand | pool
ZAPI_PROVISION_MODE=auto
# Timeout do QR/pareamento (minutos) até status EXPIRADO
WHATSAPP_ONBOARDING_TIMEOUT_MINUTES=10

# Evolution API (quando WHATSAPP_PROVIDER=evolution)
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Token para validar a rota legada /webhook/whatsapp (obrigatório em produção)
WEBHOOK_VERIFY_TOKEN=

# ---------- Transcrição de áudio (Speech-to-Text) ----------
# Permite que a IA "entenda" os áudios enviados pelo cliente.
# Compatível com a API da OpenAI. Para usar Groq (cota gratuita):
#   STT_BASE_URL=https://api.groq.com/openai/v1  e  STT_MODEL=whisper-large-v3
STT_PROVIDER=none
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_LANGUAGE=pt

# ---------- Storage de arquivos (áudios e imagens) ----------
# Opção A: local (dev) — sem nenhuma var S3 preenchida, usa o disco local.
UPLOAD_DIR=./uploads
# URL pública base para servir os arquivos locais
PUBLIC_BASE_URL=http://localhost:3001
#
# Opção B (RECOMENDADO em produção): Cloudflare R2 — storage compatível com S3.
# Dá ao áudio uma URL pública PERMANENTE (CDN) que a Z-API sempre consegue
# baixar, mesmo com o backend reiniciando. Preencha TODAS as 5 linhas abaixo.
# Como obter: Cloudflare > R2 > Crie um bucket > "Manage R2 API Tokens" (gera
# Access Key e Secret) > no bucket, ative "Public Development URL" (ou domínio).
R2_ACCOUNT_ID=                       # Account ID do Cloudflare (monta o endpoint S3)
S3_BUCKET=                           # nome do bucket (ex.: mayra-midia)
S3_ACCESS_KEY=                       # Access Key ID do token R2
S3_SECRET_KEY=                       # Secret Access Key do token R2
S3_PUBLIC_URL=                       # URL pública do bucket (ex.: https://pub-xxxx.r2.dev)
S3_REGION=auto
# Alternativa a R2_ACCOUNT_ID: informe o endpoint S3 completo manualmente.
# Ex. AWS: https://s3.us-east-1.amazonaws.com  |  R2: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=

# ---------- Servidor ----------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------- Segurança: Row-Level Security (RLS) ----------
# Defesa em profundidade: quando true (padrão), cada requisição seta o tenant na
# sessão do Postgres e o banco isola as linhas por empresa (rede de proteção
# além dos filtros da aplicação). Kill-switch de emergência: defina false para
# voltar ao isolamento só na aplicação SEM redeploy/rollback de migration.
RLS_ENFORCE=true

# ---------- Seed inicial do admin (usado por `npm run seed`) ----------
SEED_ADMIN_NAME=Mayra
SEED_ADMIN_EMAIL=mayra@loja.com
SEED_ADMIN_PASSWORD=mudar123

# ---------- Cadeado da área "Números bloqueados" ----------
# Sem default no código. Gere o hash bcrypt (lê senha do stdin):
#   echo sua_senha | npm run hash-password --workspace server
# Em produção (Render): use senha NOVA — a antiga pode ter vazado (repo público).
BLOCK_ADMIN_EMAIL=
BLOCK_ADMIN_PASSWORD_HASH=

# ---------- Segurança de mídia / webhook ----------
# Allowlist opcional de hosts no download inbound (ex.: z-api.io,seu-cdn.com)
MEDIA_FETCH_ALLOWLIST=
# Fallback /media sem ?t= (true até rodar backfill-media-tokens; depois false)
MEDIA_LEGACY_FALLBACK=true
# Minutos de pausa da IA após o operador responder no celular
HUMAN_TAKEOVER_MINUTES=30

# ---------- Busca na web (modo Agente do dono) ----------
# Liga pesquisa no WhatsApp quando a alavanca "Busca na web" estiver ON.
# Provedor: tavily | none
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=

# ---------- Frontend (Vite) ----------
# Prefixo VITE_ é exposto ao client; defina no client/.env se necessário
VITE_API_URL=http://localhost:3001
